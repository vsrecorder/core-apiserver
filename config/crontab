# core-apiserver 関連バッチの定期実行定義（ホストOSの cron。サーバ常駐で実行する）
#
# ■■ このファイルは「反映用の雛形」であって、本番の実体ではない ■■
#   自動デプロイはされない。本番で何が動いているかを知りたいときは、必ずサーバ上で
#     sudo crontab -l
#   を見ること。このファイルの内容を本番の状態だと読むと誤る（2026-08-17・08-24 の
#   週次レポートで実際に2週連続で誤読した）。内容を変えたらサーバへ反映し、逆に
#   サーバ側だけ変えたときは**このファイルも必ず追従させる**。
#
# ■ 反映方法（どちらか）
#   1) 実行ユーザーの crontab に取り込む:
#        crontab core-apiserver/crontab
#      ※ crontab コマンドは既存のエントリを丸ごと置き換える。同じユーザーに他の
#         ジョブがある場合は、この内容を「追記」すること（crontab -l で現状を退避 →
#         追記 → crontab で再登録）。
#   2) システム cron として置く場合は /etc/cron.d/vsrecorder-core-apiserver に配置し、
#      各ジョブ行の「時刻フィールドとコマンドの間」に実行ユーザー名を1つ追加する
#      （/etc/cron.d 形式はユーザー指定が必須）。
#
# ■ 前提
#   - core-apiserver 本体は distroless コンテナで動くため、バッチはコンテナ内では
#     実行できない。ホスト上でビルドした Go バイナリを叩く（下記の事前ビルド）。
#   - バイナリは実行ディレクトリの .env から DB 接続情報を読む（godotenv.Load）。
#     cron はログインシェルと環境変数が異なるため、必ず作業ディレクトリへ cd してから
#     実行し、.env を確実に読ませる。
#   - 出力ログの保存先（/var/log/vsrecorder/）は事前に作成し書き込み権限を付与しておく。
#
# ■ 事前ビルド（デプロイ時に一度。パスは環境に合わせて読み替える）
#   cd /opt/vsrecorder/core-apiserver \
#     && go build -o /opt/vsrecorder/bin/notify-streak-nudge ./cmd/notify-streak-nudge \
#     && go build -o /opt/vsrecorder/bin/notify-weekly-report ./cmd/notify-weekly-report \
#     && go build -o /opt/vsrecorder/bin/notify-weekend-reminder ./cmd/notify-weekend-reminder

# cron のタイムゾーン指定
CRON_TZ=Asia/Tokyo

# ── B-5 ストリーク途切れ防止 nudge（B5_STREAK_NUDGE_PLAN.md）──
# 毎週日曜 20:00 JST。今週まだ記録がなく、今週書かないと連続が途切れる瀬戸際の
# ユーザーへアプリ内通知を作成する。
# 2026-08 時点で本番切替済み（-dry-run=false）。検証時は -dry-run=true にすると
# 対象者をログ出力するだけで通知は作られない。
# DB_MAX_OPEN_CONNS=5 はバッチが API サーバの接続枠を食い潰さないための上限。
# flock -n は同じバッチの多重起動(前回が長引いた・手動実行と重なった)を防ぐ。
# バッチの二重送信ガードは check-then-act で DB ロックを持たないため、プロセス単位で排他する。

# 毎週日曜 20:00 JST — ストリーク途切れ防止 nudge
0 20 * * 0 cd /home/ubuntu/vsrecorder/core-apiserver && DB_MAX_OPEN_CONNS=5 flock -n /run/lock/vsrecorder-notify-streak-nudge.lock /home/ubuntu/vsrecorder/core-apiserver/bin/notify-streak-nudge -dry-run=false >> /var/log/vsrecorder/streak-nudge.log 2>&1

# ── P-2 週次バトルレポート通知（P2_WEEKLY_REPORT_PLAN.md）──
# 毎週月曜 08:00 JST。先週(月〜日)に1戦以上記録したユーザーへ、先週のバトルレポート
# (/users/report/weeks/{先週の月曜}) へ誘導するアプリ内通知(+push)を作成する。
# 先週0戦の push 購読者には代わりに環境ニュース(/deck_meta)を push で届ける。
# 同じ週の通知は二重に作らないため、多重起動しても安全。
# 導入時はまず -dry-run=true で対象者数と本文を確認し、問題なければ本番行へ切り替える。

# 毎週月曜 08:00 JST — 週次バトルレポート通知（検証: 対象者をログに出すだけ）
0 8 * * 1 cd /home/ubuntu/vsrecorder/core-apiserver && DB_MAX_OPEN_CONNS=5 flock -n /run/lock/vsrecorder-notify-weekly-report.lock /home/ubuntu/vsrecorder/core-apiserver/bin/notify-weekly-report -dry-run=true >> /var/log/vsrecorder/weekly-report.log 2>&1

# ── 本番切替時: 上をコメントアウトし、こちらを有効にする ──
# 0 8 * * 1 cd /home/ubuntu/vsrecorder/core-apiserver && DB_MAX_OPEN_CONNS=5 flock -n /run/lock/vsrecorder-notify-weekly-report.lock /home/ubuntu/vsrecorder/core-apiserver/bin/notify-weekly-report -dry-run=false >> /var/log/vsrecorder/weekly-report.log 2>&1

# ── B-2 週末リマインド（B1_B2_PUSH_NOTIFICATION_PLAN.md §5.5）──
# 毎週金曜 20:00 JST。Web Push を購読していて今週まだ記録が無い記録経験者へ、
# 週末の記録を想起させる通知(アプリ内通知 + push)を作成する。
# push には .env の VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT が必要。
# 導入時はまず -dry-run=true で対象者数を確認し、-user-id で自分宛てに1通試してから本番行へ切り替える。

# 毎週金曜 20:00 JST — 週末リマインド（検証: 対象者をログに出すだけ）
0 20 * * 5 cd /home/ubuntu/vsrecorder/core-apiserver && DB_MAX_OPEN_CONNS=5 flock -n /run/lock/vsrecorder-notify-weekend-reminder.lock /home/ubuntu/vsrecorder/core-apiserver/bin/notify-weekend-reminder -dry-run=true >> /var/log/vsrecorder/weekend-reminder.log 2>&1

# ── 本番切替時: 上をコメントアウトし、こちらを有効にする ──
# 0 20 * * 5 cd /home/ubuntu/vsrecorder/core-apiserver && DB_MAX_OPEN_CONNS=5 flock -n /run/lock/vsrecorder-notify-weekend-reminder.lock /home/ubuntu/vsrecorder/core-apiserver/bin/notify-weekend-reminder -dry-run=false >> /var/log/vsrecorder/weekend-reminder.log 2>&1

# ※ B-5 (notify-streak-nudge) と P-2 (notify-weekly-report) も同じ .env の VAPID_* を読み、
#   購読者にはアプリ内通知に加えて push を送る(B1_EXECUTION_STEPS.md Step 2-2)。
#   鍵を配布したら3本とも再ビルドしてから次の実行を待つこと。
