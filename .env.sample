# webappが発行するJWTの署名検証に使う。必須かつ32文字以上で、
# 未設定または短すぎる場合はAPIサーバが起動時に終了する。
# webappの同名の値と一致させる。
VSRECORDER_JWT_SECRET=

DB_HOSTNAME=
DB_PORT=
DB_USER_NAME=
DB_USER_PASSWORD=
DB_NAME=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# プレイヤーID連携機能のキルスイッチ。"false"を設定すると機能を停止する。
# 未設定または"false"以外の値の場合は有効。
USERS_PLAYERS_LINKING_ENABLED=

# みんなのデッキへの公開時に ACE SPEC を判定するための deckcard-api の接続先。
# 未設定なら公開ドメイン(https://vsrecorder.mobi)経由で /api/v1beta/deckcards を引く。
DECKCARD_API_BASE_URL=

# cmd/check-firebase-users(FirebaseとDBのユーザー突合ツール)でのみ使用する。
# webappの.envと同じ値を設定する。未設定の場合は GOOGLE_APPLICATION_CREDENTIALS 等の
# Application Default Credentials が使われる。
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push(VAPID)の鍵ペア。`go run ./cmd/generate-vapid-keys` で生成する。
# 公開鍵は webapp の NEXT_PUBLIC_VAPID_PUBLIC_KEY と一致させる。
# 秘密鍵を変更すると既存の購読が全て無効になるため、生成後は変更しない(バックアップを取る)。
# 未設定の場合、push は送られずアプリ内通知だけが作られる(バッチもAPIも起動する)。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# プッシュサービスからの連絡先(mailto: または https:)。VAPID の仕様上必須。
VAPID_SUBJECT=

# cmd/check-firebase-users を -notify-slack 付きで実行したときの通知先(Slackのincoming webhook)。
# FirebaseとDBのユーザーに差異が見つかったときだけ投稿する。
# このURLを知っていれば誰でもチャンネルへ投稿できるため、crontabやコードには直接書かない。
# 未設定のまま -notify-slack を指定するとバッチはエラー終了する。
SLACK_WEBHOOK_URL=
